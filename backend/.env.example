# Copy to .env.local and fill in. Never commit .env.local.

# Admin login (v1: one shared password).
ADMIN_PASSWORD=change-me-to-12-plus-chars
# Signs the admin session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Leave unset to use the built-in PGlite database in .pglite/.
# With Docker (docker compose up -d):
# DATABASE_URL=postgres://around:around@localhost:5432/around_nairobi
# Hosted (Supabase, Neon…): paste their connection string.
